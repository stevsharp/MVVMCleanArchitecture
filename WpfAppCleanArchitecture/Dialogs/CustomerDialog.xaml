<Window x:Class="WpfAppCleanArchitecture.Dialogs.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WpfAppCleanArchitecture.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CustomerDialogViewModel}"
        Title="{Binding Title}" Height="160" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Customer Name:" />
        <TextBox x:Name="NameTextBox"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,5,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save"
                    Width="75"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />
            <Button Content="Cancel"
                    Width="75"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
